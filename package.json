{
  "name": "@sliit-foss/bashaway-ui",
  "version": "0.12.4",
  "description": "Component library for Bashaway 2023",
  "main": "index.js",
  "private": false,
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components/index.js",
    "./constants": "./dist/constants/index.js",
    "./icons": "./dist/icons/index.js",
    "./hooks": "./dist/hooks/index.js",
    "./styles": "./dist/styles/index.css",
    "./typography": "./dist/components/typography/index.js",
    "./utils": "./dist/utils/index.js"
  },
  "scripts": {
    "build": "node ./esbuild.config.js",
    "bump-version": "npx automatic-versioning --skip-commit --recursive --prerelease-tag=blizzard --prerelease-branch=development --name=@sliit-foss/bashaway-ui",
    "format": "prettier --write --cache \"**/*.{js,jsx,ts,tsx,md}\"",
    "lint": "eslint . --ext js,jsx,mdx --fix --cache --report-unused-disable-directives",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "lefthook install",
    "release": "pnpm publish --access=public --no-git-checks || true",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sliit-foss/bashaway-ui.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sliit-foss/bashaway-ui/issues"
  },
  "homepage": "https://github.com/sliit-foss/bashaway-ui#readme",
  "dependencies": {
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "flowbite-react": "0.12.17",
    "framer-motion": "14.14.0",
    "lodash": "4.18.1",
    "lucide-react": "1.76.0",
    "react-icons": "5.7.0",
    "react-loader-spinner": "8.0.2",
    "react-loading-skeleton": "3.3.1",
    "tailwind-merge": "3.7.0",
    "uuid": "14.0.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-redux": "^8.1.2 || ^9.0.0",
    "react-router-dom": "^6.14.0 || ^7.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@sliit-foss/automatic-versioning": "3.0.4",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-links": "10.6.7",
    "@storybook/addon-onboarding": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/postcss": "4.3.5",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "esbuild": "0.28.2",
    "esbuild-plugin-glob": "2.2.3",
    "eslint": "10.15.0",
    "eslint-plugin-mdx": "3.10.1",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1",
    "react-router": "7.18.6",
    "react-router-dom": "7.18.6",
    "rimraf": "6.1.4",
    "storybook": "10.6.7",
    "storybook-addon-remix-react-router": "7.0.0",
    "tailwindcss": "4.3.5",
    "tailwindcss-animate": "1.0.7",
    "vite": "8.3.8"
  },
  "packageManager": "pnpm@10.34.9"
}
